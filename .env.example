# ============================================================
# Variables de entorno — PLANTILLA
# Copiar a `.env` y completar con valores reales.
# En Vite, solo las variables con prefijo VITE_ llegan al cliente.
# NUNCA colocar secretos (API keys privadas) con prefijo VITE_.
# ============================================================

# --- Identidad de la empresa ---
VITE_COMPANY_NAME="Comercializadora Los Olivos"
VITE_COMPANY_TAGLINE="Comercializadora Los Olivos E.I.R.L."

# --- Contacto ---
VITE_CONTACT_EMAIL="contacto@ejemplo.com"
VITE_CONTACT_PHONE="+569 64 19 4547 - +569 30 74 8991"
VITE_CONTACT_ADDRESS="Concordia 408 Local A, Peñaflor, Santiago, Chile"
VITE_CONTACT_HOURS="Lun–Sab 10:00–20:00 hrs"

# --- Redes sociales (bajo el nombre de la empresa) ---
VITE_SOCIAL_INSTAGRAM=""
VITE_SOCIAL_TIKTOK=""
VITE_SOCIAL_WHATSAPP=""
VITE_SOCIAL_FACEBOOK=""

# --- Redes sociales (Links de interés) ---
VITE_SOCIAL_LINKS_INSTAGRAM=""
VITE_SOCIAL_LINKS_TIKTOK=""
VITE_SOCIAL_LINKS_WHATSAPP=""
VITE_SOCIAL_LINKS_FACEBOOK=""

# --- Formulario de contacto (avisos) ---
# Backend local: ver carpeta server/ para instrucciones
VITE_FORM_ENDPOINT="http://localhost:3001/api/aviso"

# --- Chatbot backend ---
VITE_CHATBOT_API_URL="http://localhost:3002/api"

# --- Avisos backend (GET /api/avisos) ---
VITE_AVISOS_API_URL="http://localhost:3001"

# --- Email fallback (si no hay VITE_FORM_ENDPOINT configurado) ---
VITE_FALLBACK_EMAIL=""

# --- Supabase (frontend, solo lectura con anon key) ---
