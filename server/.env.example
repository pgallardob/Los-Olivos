# ============================================================
# Variables de entorno del backend
# NO subir este archivo a git.
# ============================================================

# Puerto del servidor
PORT=3001

# Origen permitido para CORS (URL del frontend)
# Separar múltiples orígenes por coma
CLIENT_ORIGIN=http://localhost:5173,http://localhost:4173

# API key de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_tu_api_key_aqui

# Email remitente (debe ser un dominio verificado en Resend)
# Mientras verificas tu dominio, usa el remitente de prueba:
MAIL_FROM=Los Olivos <onboarding@resend.dev>

# Email destino donde llegan los avisos (puedes cambiarlo cuando quieras)
MAIL_TO=pgallardob@hotmail.com

# Supabase (almacenamiento de avisos — filesystem efímero en Render)
SUPABASE_URL=https://kkeidfhyiybbngbvqjxt.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui
